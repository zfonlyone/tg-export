TZ=Asia/Shanghai
DEBUG=false
LOG_LEVEL=INFO

# Web
WEB_HOST=0.0.0.0
WEB_PORT=9528

# Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SECRET_KEY=change-this-secret-key

# Telegram API
API_ID=
API_HASH=
BOT_TOKEN=
USE_IPV6=false

# Paths (host/container)
# Host mounts are controlled by docker-compose volume vars below.
DATA_DIR=./data
DOWNLOAD_DIR=/storage/downloads
EXPORT_DIR=/downloads

# Optional
TDL_CONTAINER_NAME=tdl
PROXY_URL=

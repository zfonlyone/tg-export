TZ=Asia/Shanghai
DEBUG=false
LOG_LEVEL=INFO

# Web
WEB_HOST=0.0.0.0
WEB_PORT=9528
CORS_ALLOW_ORIGINS=

# Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SECRET_KEY=change-this-secret-key

# Telegram API
API_ID=
API_HASH=
BOT_TOKEN=
BOT_CHAT_ID=0
BOT_TOPIC_ID=0
BOT_ADMIN_IDS=
USE_IPV6=false

# Host downloads path mounted to /downloads inside the container
DOWNLOAD_DIR=/storage/downloads
EXPORT_DIR=/downloads

# Optional
PROXY_URL=
DISABLE_PERMISSION_FIX=true
